# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=sklad
POSTGRES_PASSWORD=sklad
POSTGRES_DB=sklad
POSTGRES_PORT=5432

# --- Backend ---
# Inside docker compose the host is "db"; for local runs use localhost.
DATABASE_URL=postgresql+psycopg://sklad:sklad@localhost:5432/sklad
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:5173

# Initial administrator created on first start (if no users exist)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin12345

# --- Ports ---
API_PORT=8000
WEB_PORT=8080
